# =============================================================================
# Frontend Environment Variables — Copy this file to .env and fill in values
# =============================================================================
# IMPORTANT: All VITE_* variables are EXPOSED IN THE BROWSER.
#            Do NOT put secrets, API keys, or credentials here.
# =============================================================================

# Base URL of the Flask backend API
# Local development default:
VITE_API_BASE_URL=http://localhost:5000

# Maximum image file size in bytes (must match backend — default 10 MB)
VITE_MAX_FILE_SIZE_BYTES=10485760
