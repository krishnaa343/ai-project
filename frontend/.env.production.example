# ==============================================================================
# Frontend Production Environment — Vercel
# DO NOT commit this file with real values.
# Set these as Environment Variables in the Vercel dashboard instead.
# ==============================================================================

# The deployed Flask backend URL (set this in Vercel dashboard after backend deploy)
VITE_API_BASE_URL=https://your-backend-app.onrender.com

# Max file upload size (10 MB in bytes) — public, not secret
VITE_MAX_FILE_SIZE_BYTES=10485760
