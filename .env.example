# ==============================================================================
# Crop Disease Detection Framework - Environment Configuration Template
# Copy this file to backend/.env and configure local credentials before running.
# ==============================================================================

# Flask Server Configuration
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_PORT=5000
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Client Origins (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=crop_disease_detection
MYSQL_USER=root
MYSQL_PASSWORD=
