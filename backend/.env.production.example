# ==============================================================================
# Backend Production Environment Template
# Project: AI-Based Intelligent Crop Disease Detection Framework
#
# DO NOT commit this file with real values.
# Set these as Environment Variables in the Render dashboard.
# Copy from backend/.env.example and fill production values.
# ==============================================================================

# Flask Server Configuration
FLASK_ENV=production
FLASK_DEBUG=0
FLASK_PORT=10000

# Replace with a strong random string (e.g., python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_KEY

# CORS — set to your actual Vercel frontend URL after deployment
ALLOWED_ORIGINS=https://your-app.vercel.app

# MySQL Configuration — set to your Railway/cloud MySQL values
MYSQL_HOST=REPLACE_WITH_RAILWAY_MYSQL_HOST
MYSQL_PORT=3306
MYSQL_DATABASE=crop_disease_detection
MYSQL_USER=REPLACE_WITH_DB_USER
MYSQL_PASSWORD=REPLACE_WITH_DB_PASSWORD
